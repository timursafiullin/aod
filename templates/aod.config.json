{
  "base_branch": "main",
  "slots": 2,
  "worktrees_dir": "../{repo}-worktrees",
  "codex": {
    "command": null,
    "sandbox": "workspace-write"
  },
  "routing": {
    "preset": "max",
    "implement": {
      "model": "gpt-6.1-sol",
      "effort": "medium"
    },
    "escalate": {
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    "explore": {
      "model": "gpt-6-luna",
      "effort": "low"
    }
  },
  "timeouts": {
    "budget_factor": 1.5,
    "idle_minutes": 20
  },
  "forbidden_always": [
    "schemas/**",
    "tests/acceptance/**",
    ".agents/**"
  ],
  "protected": [
    "schemas/**",
    "tests/acceptance/**"
  ],
  "test_globs": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/*_test.go",
    "**/tests/**",
    "**/test/**",
    "**/__tests__/**"
  ],
  "guards": {
    "git": true,
    "contracts": true
  },
  "stop_gate": {
    "enabled": false,
    "commands": [],
    "timeout_minutes": 10
  },
  "session": {
    "baseline": []
  },
  "max_rounds": 3
}
